{
  "expo": {
    "name": "Skill Sprout",
    "slug": "skillsprout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/skill-sprout-icon.png",
    "scheme": "skillsprout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillsprout.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.skillsprout.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/skill-sprout-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#059669"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a86a0709-7543-439d-8543-a925945743bc"
      }
    },
    "owner": "joshritchiedev"
  }
}
